{
    "version": 6,
    "configurePresets": [
        {
            "name": "debug",
            "displayName": "GCC debug configure preset",
            "description": "Sets Ninja generator, build and install directory",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/$env{BUILD_DIR}/install",
                "ENABLE_TEST": "ON",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "1",
                "ENABLE_PRECOMMIT": "ON"
            },
            "environment": {
                "BUILD_DIR": "build"
            }
        },
        {
            "name": "debug-clang",
            "displayName": "Clang debug configure preset",
            "description": "Sets Ninja generator, build and install directory",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-clang",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/$env{BUILD_DIR}/install",
                "ENABLE_TEST": "ON",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "1",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "ENABLE_PRECOMMIT": "ON"
            },
            "environment": {
                "BUILD_DIR": "build-clang"
            }
        },
        {
            "name": "github-ci-debug",
            "displayName": "Github CI configure preset",
            "description": "Sets Ninja generator, build and install directory",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/${presetName}",
                "ENABLE_TEST": "ON",
                "BUILD_DOC": "ON",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "1"
            }
        },
        {
            "name": "release",
            "displayName": "Relase configure preset",
            "description": "Sets Ninja generator, build and install directory",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/$env{BUILD_DIR}/install"
            },
            "environment": {
                "BUILD_DIR": "build-release"
            }
        },
        {
            "name": "debug-sccache",
            "inherits": "debug",
            "displayName": "GCC debug configure preset with sccache",
            "description": "Caches the compiler output with sccache",
            "binaryDir": "${sourceDir}/build-sccache",
            "cacheVariables": {
                "CMAKE_C_COMPILER_LAUNCHER": "sccache",
                "CMAKE_CXX_COMPILER_LAUNCHER": "sccache"
            },
            "environment": {
                "BUILD_DIR": "build-sccache"
            }
        },
        {
            "name": "debug-clang-sccache",
            "inherits": "debug-clang",
            "displayName": "Clang debug configure preset with sccache",
            "description": "Caches the compiler output with sccache",
            "binaryDir": "${sourceDir}/build-clang-sccache",
            "cacheVariables": {
                "CMAKE_C_COMPILER_LAUNCHER": "sccache",
                "CMAKE_CXX_COMPILER_LAUNCHER": "sccache"
            },
            "environment": {
                "BUILD_DIR": "build-clang-sccache"
            }
        },
        {
            "name": "release-sccache",
            "inherits": "release",
            "displayName": "Release configure preset with sccache",
            "description": "Caches the compiler output with sccache",
            "binaryDir": "${sourceDir}/build-release-sccache",
            "cacheVariables": {
                "CMAKE_C_COMPILER_LAUNCHER": "sccache",
                "CMAKE_CXX_COMPILER_LAUNCHER": "sccache"
            },
            "environment": {
                "BUILD_DIR": "build-release-sccache"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "debug-clang",
            "configurePreset": "debug-clang"
        },
        {
            "name": "github-ci-debug",
            "configurePreset": "github-ci-debug"
        },
        {
            "name": "release",
            "configurePreset": "release"
        },
        {
            "name": "debug-sccache",
            "configurePreset": "debug-sccache"
        },
        {
            "name": "debug-clang-sccache",
            "configurePreset": "debug-clang-sccache"
        },
        {
            "name": "release-sccache",
            "configurePreset": "release-sccache"
        }
    ],
    "testPresets": [
        {
            "name": "test",
            "configurePreset": "debug"
        },
        {
            "name": "github-test",
            "configurePreset": "github-ci-debug"
        },
        {
            "name": "test-sccache",
            "configurePreset": "debug-sccache"
        }
    ],
    "workflowPresets": [
        {
            "name": "debug",
            "displayName": "Debug workflow",
            "description": "Configures and builds the debug preset",
            "steps": [
                {
                    "type": "configure",
                    "name": "debug"
                },
                {
                    "type": "build",
                    "name": "debug"
                }
            ]
        },
        {
            "name": "release",
            "displayName": "Release workflow",
            "description": "Configures and builds the release preset",
            "steps": [
                {
                    "type": "configure",
                    "name": "release"
                },
                {
                    "type": "build",
                    "name": "release"
                }
            ]
        },
        {
            "name": "debug-sccache",
            "displayName": "Debug workflow with sccache",
            "description": "Configures and builds the debug-sccache preset",
            "steps": [
                {
                    "type": "configure",
                    "name": "debug-sccache"
                },
                {
                    "type": "build",
                    "name": "debug-sccache"
                }
            ]
        },
        {
            "name": "release-sccache",
            "displayName": "Release workflow with sccache",
            "description": "Configures and builds the release-sccache preset",
            "steps": [
                {
                    "type": "configure",
                    "name": "release-sccache"
                },
                {
                    "type": "build",
                    "name": "release-sccache"
                }
            ]
        }
    ]
}
